---
import Layout from "../layouts/Layout.astro";
import FAQs from "@/components/sections/FAQs.astro";
---

<Layout
  title="Premium Roofing, Solar & Electrical Services | Roofero"
  description="Discover Roofero's premium home services: certified roofing craftsmanship, advanced solar power integration, expert wiring, and reliable leak repairs. Details ✓"
>
  <main class="page-wrapper">
      <!-- Hero & Services List Section -->
      <section id="services-list" class="section-wrapper">
        <div class="max-w-[1440px] mx-auto flex flex-col gap-12 w-full">
        <!-- Label Section -->
        <div class="flex flex-col items-start w-full">
          <!-- Label -->
          <span
            class="text-foreground font-heading text-base font-semibold border-b border-foreground pb-1 inline-block mb-4"
          >
            Services
          </span>
          <!-- Main Heading -->
          <h1 class="text-foreground tracking-tight leading-tight mb-8">
            Reliable Repairs
          </h1>
        </div>

        <!-- Services Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8">
          <!-- Card 1 (Wiring & Rewiring) -->
          <div
            class="group relative flex items-center justify-between p-8 md:p-10 rounded-[20px] bg-light-gray dark:bg-white/5 border border-light-neutral dark:border-white/5 transition-all duration-300 hover:bg-electric-lime cursor-pointer"
          >
            <div class="flex flex-col items-start max-w-[80%]">
              <div
                class="size-12 rounded-full bg-deep-black flex items-center justify-center text-electric-lime mb-8"
              >
                <i class="ph ph-lightning text-[24px]"></i>
              </div>
              <h2
                class="h5 text-foreground transition-colors duration-300 group-hover:text-deep-black mb-3"
              >
                Wiring & Rewiring
              </h2>
              <p
                class="text-muted-foreground body-sm transition-colors duration-300 group-hover:text-deep-black/80 leading-relaxed font-medium"
              >
                Reliable and affordable plumbing—leaks, repairs, or
                replacements, we fix it right the first time.
              </p>
            </div>
            <div
              class="size-12 rounded-full border border-black/10 dark:border-white/10 flex items-center justify-center text-foreground transition-all duration-300 group-hover:bg-deep-black group-hover:text-electric-lime group-hover:border-transparent shrink-0"
            >
              <i class="ph ph-arrow-up-right text-[20px]"></i>
            </div>
          </div>

          <!-- Card 2 (Leak Repair) -->
          <div
            class="group relative flex items-center justify-between p-8 md:p-10 rounded-[20px] bg-light-gray dark:bg-white/5 border border-light-neutral dark:border-white/5 transition-all duration-300 hover:bg-electric-lime cursor-pointer"
          >
            <div class="flex flex-col items-start max-w-[80%]">
