---
import Layout from "../layouts/Layout.astro";
import ContactForm from "../components/ContactForm";
import FAQs from "@/components/sections/FAQs.astro";
---

<Layout
  title="Contact Our Roofing & Solar Experts — Free Quote | Roofero"
  description="Ready to protect your property? Contact Roofero's roofing and solar experts to get a free estimate. We respond within 24 hours to schedule your inspection ✓"
>
  <main class="page-wrapper">
    <section id="contact-form-section" class="section-wrapper">
      <div
        class="max-w-[1440px] mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-start"
      >
        <div class="text-left pt-2">
          <!-- Label -->
          <span
            class="text-foreground font-heading text-base font-semibold border-b border-foreground pb-1 inline-block mb-8"
          >
            Contact Us
          </span>
          <!-- Heading -->
          <h1 class="text-foreground tracking-tight leading-tight mb-8">
            Ready to protect your property?
          </h1>
          <p class="text-muted-foreground body-text mb-8 max-w-lg">
            Fill out our form to request a free estimate. Our team of roofing
            and solar experts will review your request and contact you within 24
            hours to schedule an inspection.
          </p>
          <div class="space-y-4 font-sans text-lg">
            <div class="flex items-center gap-3 text-foreground">
              <i
                class="ph ph-phone text-[20px] text-brand-dark dark:text-electric-lime"
              ></i>
              <span>Call us directly: <strong>+1 (555) 0199</strong></span>
            </div>
            <div class="flex items-center gap-3 text-foreground">
              <i
                class="ph ph-envelope text-[20px] text-brand-dark dark:text-electric-lime"
              ></i>
              <span>Email: <strong>info@roofero.com</strong></span>
            </div>
          </div>
        </div>

        <div class="w-full">
          <ContactForm client:load />
        </div>
      </div>
    </section>

    <!-- Google Maps Section -->
    <section id="contact-map" class="section-wrapper pb-0">
      <div class="max-w-[1440px] mx-auto">
        <div
          class="w-full h-[500px] md:h-[800px] rounded-lg overflow-hidden border border-border shadow-sm"
        >
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d100939.8166549257!2d-122.5076401912836!3d37.7578150035022!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x80859a6d00690021%3A0x4a501367f076adff!2sSan%20Francisco%2C%20CA!5e0!3m2!1sen!2sus!4v1700000000000!5m2!1sen!2sus"
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="grayscale dark:invert contrast-[1.1] brightness-[0.9] dark:opacity-80"
          ></iframe>
        </div>
      </div>
    </section>

    <section id="contact-faqs" class="section-wrapper">
      <div class="max-w-[1440px] mx-auto">
        <FAQs />
      </div>
    </section>
  </main>
</Layout>
