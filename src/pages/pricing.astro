            <div
              class="size-14 shrink-0 rounded-full bg-deep-black flex items-center justify-center shadow-md"
            >
              <!-- Lightning Bolt SVG -->
              <svg
                class="w-6 h-6 text-electric-lime"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
                xmlns="http://www.w3.org/2000/svg"
              >
