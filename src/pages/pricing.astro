---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Roofing & Solar Pricing — Transparent Service Plans | Roofero"
  description="Explore Roofero's premium roof inspection, repair, and solar maintenance plans with transparent pricing. Compare packages and choose the perfect fit today ✓"
>
  <main class="page-wrapper">
    <!-- Header Section -->
    <section id="pricing-header" class="text-center mb-16 animate-fade-in">
      <a
        href="#pricing-plans"
        class="text-[13px] md:text-sm font-semibold border-b border-foreground pb-0.5 tracking-wider inline-block text-foreground hover:opacity-85 transition-opacity duration-300"
      >
        Pricing Plans
      </a>
      <h1 class="mt-6 tracking-tight text-brand-dark">Transparent Pricing</h1>
    </section>

    <!-- Pricing Cards Grid -->
    <section id="pricing-plans" class="max-w-[1040px] mx-auto px-6 md:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
        <!-- Basic Plan Card -->
        <div
          class="bg-light-neutral rounded-[24px] p-8 md:p-10 flex flex-col justify-between transition-all duration-300 hover:-translate-y-1.5 hover:shadow-xl hover:shadow-black/5"
        >
          <div>
            <h4 class="text-brand-dark">Basic Plan</h4>
            <p class="body-sm text-medium-gray mt-3">
              Our Basic Plan covers essential roof inspection and best for
              maintenance to prevent costly repairs.
            </p>

            <div class="flex items-baseline mt-6 mb-3">
              <span
                class="text-[44px] md:text-[52px] font-bold font-urbanist text-brand-dark leading-none"
                >$299</span
              >
              <span class="text-sm font-semibold text-medium-gray ml-1"
                >/month</span
              >
            </div>

            <div class="w-full h-[1px] bg-black/10 my-6"></div>

            <button
              class="w-full py-3.5 px-6 rounded-[8px] bg-transparent border border-black/15 text-deep-black font-semibold text-sm tracking-wide transition-all duration-300 hover:bg-black/[0.03] hover:border-black/30 cursor-pointer text-center"
            >
              Get Started
            </button>

            <!-- Features List -->
            <ul class="mt-8 space-y-4">
              <li class="flex items-center gap-3">
                <svg
                  class="w-[18px] h-[18px] text-foreground shrink-0"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  viewBox="0 0 24 24"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"
                  ></path>
                </svg>
                <span class="body-sm font-semibold text-brand-dark"
                  >Minor Repairs Included</span
                >
              </li>
              <li class="flex items-center gap-3">
                <svg
                  class="w-[18px] h-[18px] text-foreground shrink-0"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  viewBox="0 0 24 24"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"
                  ></path>
                </svg>
                <span class="body-sm font-semibold text-brand-dark"
                  >Gutter Cleaning</span
                >
              </li>
              <li class="flex items-center gap-3">
                <svg
                  class="w-[18px] h-[18px] text-foreground shrink-0"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  viewBox="0 0 24 24"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"
                  ></path>
                </svg>
                <span class="body-sm font-semibold text-brand-dark"
                  >1-Year Service Warranty</span
                >
              </li>
              <li class="flex items-center gap-3">
                <svg
                  class="w-[18px] h-[18px] text-foreground shrink-0"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  viewBox="0 0 24 24"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"
                  ></path>
                </svg>
                <span class="body-sm font-semibold text-brand-dark"
