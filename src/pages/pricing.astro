          <div
            class="w-full md:w-auto shrink-0 flex items-center self-stretch md:self-auto"
          >
            <button
              class="w-full md:w-auto py-3.5 px-10 rounded-[8px] bg-transparent border border-black/15 text-deep-black font-semibold text-sm tracking-wide transition-all duration-300 hover:bg-black/[0.03] hover:border-black/30 cursor-pointer text-center min-w-[180px]"
            >
