      class="mt-20 md:mt-28 max-w-[1040px] mx-auto px-6 md:px-8"
    >
      <!-- Label and Heading -->
      <div class="mb-12">
        <span
          class="text-[13px] md:text-sm font-semibold border-b border-foreground pb-0.5 tracking-wider inline-block text-foreground hover:opacity-85 transition-opacity duration-300"
