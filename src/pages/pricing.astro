            <!-- Spacer to align the Premium Plan button with Basic Plan button perfectly -->
            <div class="w-full h-[1px] bg-transparent my-6"></div>

            <button
              class="w-full py-3.5 px-6 rounded-[8px] bg-brand-dark text-white font-semibold text-sm tracking-wide transition-all duration-300 hover:bg-deep-black cursor-pointer text-center"
            >
              Get Started
            </button>

            <!-- Features List -->
            <ul class="mt-8 space-y-4">
              <li class="flex items-center gap-3">
                <svg
                  class="w-[18px] h-[18px] text-foreground shrink-0"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  viewBox="0 0 24 24"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"
                  ></path>
