---
import { Button } from "../ui/button";
import { projects } from "@/data/projects";
---

<section id="projects">
  <div class="max-w-[1440px] mx-auto flex flex-col">
    <!-- Section Header -->
    <div
      class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-16"
    >
      <div class="flex flex-col items-start text-left">
        <span
          class="text-foreground font-heading text-base font-semibold border-b border-foreground pb-1 mb-8"
        >
          Projects
        </span>
        <h2 class="text-foreground max-w-2xl">
          Delivering excellence through projects with proven results
        </h2>
      </div>
      <div class="shrink-0 flex justify-start md:justify-end w-full md:w-auto">
        <a href="/projects">
          <Button variant="secondary" size="lg" client:load>
            View all Work
          </Button>
        </a>
      </div>
    </div>

    <!-- Projects Grid -->
    <div class="grid grid-cols-1 md:grid-cols-6 gap-x-8 gap-y-16 w-full">
      {
        projects.map((project, index) => {
          const colSpan =
            index < 2 ? "col-span-1 md:col-span-3" : "col-span-1 md:col-span-2";
          const aspect =
            index < 2
              ? "aspect-[4/3] md:aspect-[8/6]"
              : "aspect-[4/3] md:aspect-[7/8]";

          return (
            <a
              href={`/projects/${project.slug}`}
              class={`${colSpan} flex flex-col items-start text-left group cursor-pointer`}
            >
              <div
                class={`w-full ${aspect} overflow-hidden rounded-lg border border-border shadow-sm`}
              >
                <img
                  src={project.mainImage}
                  alt={project.title}
                  class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
                />
              </div>
              <div class="flex items-center gap-1.5 mt-4 text-medium-gray font-sans text-sm">
                <i class="ph ph-map-pin text-[16px] shrink-0 text-medium-gray" />
                <span>{project.location}</span>
              </div>
              <h3 class="h5 text-foreground mt-2 group-hover:text-brand-dark dark:group-hover:text-electric-lime transition-colors">
                {project.title}
              </h3>
            </a>
          );
        })
      }
    </div>
  </div>
</section>
