---

---

<!-- Footer Section -->
<footer
  id="main-footer"
  class="bg-brand-dark text-white overflow-hidden relative"
>
  <!-- Footer Banner (CTA) -->
  <section
    class="relative w-full h-[400px] sm:h-[480px] md:h-[540px] lg:h-[620px] flex items-end overflow-hidden"
  >
    <!-- Background Image -->
    <div class="absolute inset-0 z-0">
      <img
        src="/images/footer-banner-bg.jpg"
        alt="Roofero technician working on roof"
        class="w-full h-full object-cover object-center"
      />
      <!-- Gradient overlay for readability and premium look -->
      <div
        class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/20 to-transparent"
      >
      </div>
    </div>

    <div
      class="relative z-10 max-w-[1440px] mx-auto w-full px-6 md:px-[60px] pb-12 md:pb-16 lg:pb-20 flex flex-col md:flex-row md:items-end justify-between gap-8"
    >
      <div class="text-left max-w-xl">
        <span
          class="text-white/70 font-sans text-xs uppercase tracking-wider font-semibold block mb-3"
        >
          Get In Touch
        </span>
        <h2 class="text-white">
          Helpful tips for a<br class="hidden sm:inline" /> safer stronger home
        </h2>
      </div>
      <div class="shrink-0 flex items-center md:pb-2">
        <a href="/pricing">
          <button
            class="bg-electric-lime text-brand-dark font-heading font-semibold text-lg px-8 py-4 rounded-full hover:bg-electric-lime-hover active:bg-electric-lime-active transition-all tracking-wider cursor-pointer"
          >
            Start Your Project
          </button>
        </a>
      </div>
    </div>
  </section>

  <!-- Footer Content -->
  <div
    class="max-w-[1440px] mx-auto w-full px-6 md:px-[60px] pt-16 md:pt-24 pb-8 md:pb-12"
  >
    <!-- 4-Column Grid -->
    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12 lg:gap-16"
    >
      <!-- Column 1: Company -->
      <div class="flex flex-col items-start text-left">
        <p class="h6 text-white mb-4 font-semibold">Company</p>
        <p class="text-white/60 font-sans text-sm mb-6 leading-relaxed max-w-sm">
          Roofero is a premier provider of certified roofing and home repair services. We deliver high-quality craftsmanship, reliable solutions, and lasting protection.
        </p>
        <ul class="space-y-3 font-sans text-base text-white/60">
          <li class="flex items-center gap-2">
            <i class="ph ph-map-pin text-[18px] text-electric-lime shrink-0"></i>
            <span>123 Roofline Ave City, State ZIP</span>
          </li>
          <li class="flex items-center gap-2">
            <i class="ph ph-phone text-[18px] text-electric-lime shrink-0"></i>
            <span>(123) 456-7890</span>
          </li>
          <li class="flex items-center gap-2">
            <i class="ph ph-envelope text-[18px] text-electric-lime shrink-0"></i>
            <a
              href="mailto:contact@rofoora.com"
              class="hover:text-electric-lime transition-colors"
            >
              contact@rofoora.com
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 2: Follow Us -->
      <div class="flex flex-col items-start text-left">
        <p class="h6 text-white mb-6 font-semibold">Follow Us</p>
        <ul class="space-y-3 font-sans text-base">
          <li>
            <a
              href="https://facebook.com"
              target="_blank"
              rel="noopener noreferrer"
              class="text-white/60 hover:text-electric-lime transition-colors flex items-center gap-2"
            >
              <i class="ph ph-facebook-logo text-[18px] text-electric-lime"></i>
              <span>Facebook</span>
            </a>
          </li>
          <li>
            <a
              href="https://instagram.com"
              target="_blank"
              rel="noopener noreferrer"
              class="text-white/60 hover:text-electric-lime transition-colors flex items-center gap-2"
            >
              <i class="ph ph-instagram-logo text-[18px] text-electric-lime"></i>
              <span>Instagram</span>
            </a>
          </li>
          <li>
            <a
              href="https://linkedin.com"
              target="_blank"
              rel="noopener noreferrer"
              class="text-white/60 hover:text-electric-lime transition-colors flex items-center gap-2"
            >
              <i class="ph ph-linkedin-logo text-[18px] text-electric-lime"></i>
              <span>Linkedin</span>
            </a>
          </li>
          <li>
            <a
              href="https://hotstar.com"
              target="_blank"
              rel="noopener noreferrer"
              class="text-white/60 hover:text-electric-lime transition-colors flex items-center gap-2"
            >
              <i class="ph ph-globe text-[18px] text-electric-lime"></i>
              <span>Hotstar</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 3: Newsletter -->
      <div class="flex flex-col items-start text-left">
        <p class="h6 text-white mb-6 font-semibold">Subscribe Our Newsletter</p>

        <!-- Input Field Container -->
        <div class="relative w-full max-w-[320px] mb-4">
          <input
            type="email"
            placeholder="Email Address"
            class="w-full bg-transparent border border-white/20 rounded-lg px-4 py-3 pr-12 text-base text-white placeholder-white/40 focus:outline-none focus:border-electric-lime transition-colors font-sans"
          />
          <button
            class="absolute right-0 top-1/2 -translate-y-1/2 w-12 h-12 flex items-center justify-center text-white/60 hover:text-electric-lime transition-colors cursor-pointer"
            aria-label="Subscribe to newsletter"
          >
            <i class="ph ph-arrow-up-right text-[18px]"></i>
          </button>
        </div>

        <p
          class="text-white/70 font-sans text-sm leading-relaxed max-w-[280px]"
        >
          Reliable roofing solutions built to safeguarding your home expert
          craftsmanship.
        </p>
      </div>
    </div>

    <!-- Footer Bottom Bar (Privacy & Terms) -->
    <div class="border-t border-white/10 mt-16 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-white/50 font-sans text-sm">
        © 2026 Roofero. All rights reserved.
      </p>
      <div class="flex items-center gap-6 text-sm font-sans text-white/50">
        <a href="/privacy-policy" class="hover:text-electric-lime transition-colors hover:no-underline">
          Privacy Policy
        </a>
        <span class="text-white/20 select-none">|</span>
        <a href="/terms-of-service" class="hover:text-electric-lime transition-colors hover:no-underline">
          Terms of Service
        </a>
      </div>
    </div>
  </div>

  <!-- Centered Giant Logo (Flush at the bottom & cropped) -->
  <div class="relative w-full overflow-hidden flex justify-center items-end">
    <div
      class="flex items-center gap-4 sm:gap-6 lg:gap-8 translate-y-[15%] md:translate-y-[20%] select-none pointer-events-none"
    >
      <!-- Sprout Icon -->
      <svg
        class="w-16 h-16 sm:w-28 sm:h-28 md:w-48 md:h-48 lg:w-60 lg:h-60 xl:w-72 xl:h-72 text-electric-lime fill-current shrink-0"
        viewBox="0 0 100 100"
      >
        <circle cx="50" cy="20" r="10"></circle>
        <path
          d="M 50 46 C 42 46 32 38 24 34 L 24 68 C 24 82 38 92 50 95 C 62 92 76 82 76 68 L 76 34 C 68 38 58 46 50 46 Z"
        ></path>
      </svg>
      <!-- Logo Text -->
      <span
        class="text-white font-heading font-bold text-[60px] sm:text-[100px] md:text-[180px] lg:text-[220px] xl:text-[260px] tracking-tight leading-none"
      >
        Roofero
      </span>
    </div>
  </div>
</footer>
