<section id="faqs">
  <div
    class="max-w-[1440px] mx-auto grid grid-cols-1 lg:grid-cols-[5fr_7fr] gap-12 lg:gap-24"
  >
    <!-- Left Column (Header) -->
    <div class="text-left lg:sticky lg:top-[120px] h-fit">
      <span
        class="text-deep-black font-heading text-base md:text-lg font-semibold border-b border-deep-black pb-1 mb-6 inline-block"
      >
        FAQs
      </span>
      <h2 class="text-deep-black max-w-md animate-fade-in">
        Everything you need to know now
      </h2>
    </div>

    <!-- Right Column (Accordion) -->
    <div class="flex flex-col gap-4">
      <!-- Item 1 -->
      <div
        class="faq-item group active bg-light-gray rounded-lg border border-border overflow-hidden transition-all duration-300"
      >
        <button
          class="faq-toggle w-full flex items-center justify-between text-left p-6 md:p-8 cursor-pointer focus:outline-none"
          aria-expanded="true"
        >
          <h3 class="h6 text-deep-black pr-4 leading-tight">
            How do I know my roof needs repair or replacement?
          </h3>
          <span class="flex-shrink-0 text-deep-black">
            <!-- Plus Icon -->
            <svg
              class="size-6 faq-plus block group-[.active]:hidden"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              viewBox="0 0 24 24"
            >
              <circle cx="12" cy="12" r="9"></circle>
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 9v6m-3-3h6"></path>
            </svg>
            <!-- Minus Icon -->
            <svg
              class="size-6 faq-minus hidden group-[.active]:block"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              viewBox="0 0 24 24"
            >
              <circle cx="12" cy="12" r="9"></circle>
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 12H9"
              ></path>
            </svg>
          </span>
        </button>
        <div
          class="faq-content grid grid-rows-[0fr] group-[.active]:grid-rows-[1fr] transition-[grid-template-rows] duration-300 ease-in-out"
        >
          <div class="overflow-hidden">
            <p
              class="px-6 md:px-8 pb-6 md:pb-8 text-muted-foreground body-sm max-w-[640px]"
            >
              Common signs include missing shingles, water stains on ceilings,
              granule buildup in gutters, or visible sagging. If your roof is
              over 15-20 years old, it's a good idea to schedule an inspection
              to assess its condition.
            </p>
          </div>
        </div>
      </div>

      <!-- Item 2 -->
      <div
        class="faq-item group active bg-light-gray rounded-lg border border-border overflow-hidden transition-all duration-300"
      >
        <button
