---

---

<section
  id="industries"
  class="bg-brand-dark text-white py-20 md:py-32 px-6 md:px-[60px]"
>
  <div class="max-w-[1440px] mx-auto flex flex-col">
    <!-- Label and Title -->
    <div class="flex flex-col items-start text-left mb-16">
      <span
        class="text-white font-heading text-base font-semibold border-b border-white pb-1 mb-8"
      >
        Industries
      </span>
      <h2 class="text-white max-w-2xl">
        Delivering excellence across all key industries
      </h2>
    </div>

    <!-- Stats Row with Generated Workers Photo -->
    <div
      class="flex flex-col md:flex-row items-start md:items-center gap-10 md:gap-12 lg:gap-16 mb-20"
    >
      <!-- Left side: image -->
      <div class="shrink-0 w-full md:w-auto">
        <img
          src="/images/industries-workers.jpg"
          alt="Roofero construction workers on a roof"
          class="w-full md:w-[320px] lg:w-[400px] aspect-[4/3] object-cover rounded-lg border border-white/10 shadow-lg"
        />
      </div>

      <!-- Right side: stats -->
      <div
        class="flex-1 grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-8 lg:gap-12 w-full"
      >
        <!-- Stat 1 -->
        <div class="flex flex-col items-start text-left">
          <div
            class="text-electric-lime font-heading font-semibold text-4xl md:text-5xl lg:text-6xl leading-tight"
          >
            1250<sup class="font-light">+</sup>
          </div>
          <div class="text-white/70 body-sm md:body-text mt-2">
            Refreshed in 2025
          </div>
        </div>

        <!-- Stat 2 -->
        <div class="flex flex-col items-start text-left">
          <div
            class="text-electric-lime font-heading font-semibold text-4xl md:text-5xl lg:text-6xl leading-tight"
          >
            500+<sup class="font-light">+</sup>
          </div>
          <div class="text-white/70 body-sm md:body-text mt-2">
            Project Completed
          </div>
        </div>

        <!-- Stat 3 -->
        <div class="flex flex-col items-start text-left">
          <div
            class="text-electric-lime font-heading font-semibold text-4xl md:text-5xl lg:text-6xl leading-tight"
          >
            10<sup class="font-light">+</sup>
          </div>
          <div class="text-white/70 body-sm md:body-text mt-2">
            Years of Experience
          </div>
        </div>
      </div>
    </div>

    <!-- Partner Logos Grid -->
    <div
      class="grid grid-cols-2 md:grid-cols-4 gap-[1px] bg-white/10 border border-white/10 rounded-lg overflow-hidden shadow-inner"
    >
      <!-- Logo 1: CodeLab -->
      <div
        class="bg-brand-dark h-32 md:h-40 flex items-center justify-center p-6 hover:bg-white/[0.02] transition-colors duration-300"
      >
        <div
          class="flex items-center text-white/50 hover:text-white/80 transition-colors"
        >
          <svg
            class="size-8 md:size-9 mr-3"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M8 4H6a2 2 0 00-2 2v3a2 2 0 01-2 2 2 2 0 012 2v3a2 2 0 002 2h2m8-14h2a2 2 0 012 2v3a2 2 0 002 2 2 2 0 00-2 2v3a2 2 0 01-2 2h-2"
            ></path>
          </svg>
          <span
            class="font-heading font-semibold tracking-tight text-xl md:text-2xl"
            >CodeLab</span
          >
        </div>
      </div>

      <!-- Logo 2: circle -->
      <div
        class="bg-brand-dark h-32 md:h-40 flex items-center justify-center p-6 hover:bg-white/[0.02] transition-colors duration-300"
      >
        <div
          class="flex items-center text-white/50 hover:text-white/80 transition-colors"
        >
          <svg
            class="size-8 md:size-9 mr-3"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="3"
          >
            <circle cx="12" cy="12" r="8"></circle>
          </svg>
          <span
            class="font-heading font-semibold tracking-tight text-xl md:text-2xl"
            >circle</span
          >
        </div>
      </div>

      <!-- Logo 3: nirast -->
      <div
        class="bg-brand-dark h-32 md:h-40 flex items-center justify-center p-6 hover:bg-white/[0.02] transition-colors duration-300"
      >
        <div
          class="flex items-center text-white/50 hover:text-white/80 transition-colors"
        >
          <svg
            class="size-8 md:size-9 mr-3"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M4 21h16M7 21V9l5-4 5 4v12M12 9v12M9 13v8M15 13v8"></path>
          </svg>
          <span
            class="font-heading font-semibold tracking-tight text-xl md:text-2xl"
            >nirast</span
          >
        </div>
      </div>

      <!-- Logo 4: Radiyal -->
      <div
        class="bg-brand-dark h-32 md:h-40 flex items-center justify-center p-6 hover:bg-white/[0.02] transition-colors duration-300"
      >
        <div
          class="flex items-center text-white/50 hover:text-white/80 transition-colors"
        >
          <svg
            class="size-8 md:size-9 mr-3"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 3v18M3 12h18m-3-6L6 18M6 6l12 12"></path>
          </svg>
          <span
            class="font-heading font-semibold tracking-tight text-xl md:text-2xl"
            >Radiyal</span
          >
        </div>
      </div>

      <!-- Logo 5: ASGARDIA -->
      <div
        class="bg-brand-dark h-32 md:h-40 flex items-center justify-center p-6 hover:bg-white/[0.02] transition-colors duration-300"
      >
        <div
          class="flex items-center text-white/50 hover:text-white/80 transition-colors"
        >
          <svg
            class="size-8 md:size-9 mr-3"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3 21h18M6 21V11m4 10V7m4 10v-6m4 6V3"></path>
          </svg>
          <span
            class="font-heading font-bold tracking-wider text-lg md:text-xl uppercase"
            >ASGARDIA</span
          >
        </div>
      </div>

      <!-- Logo 6: nirast -->
      <div
        class="bg-brand-dark h-32 md:h-40 flex items-center justify-center p-6 hover:bg-white/[0.02] transition-colors duration-300"
      >
        <div
          class="flex items-center text-white/50 hover:text-white/80 transition-colors"
        >
          <svg
            class="size-8 md:size-9 mr-3"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M4 21h16M7 21V9l5-4 5 4v12M12 9v12M9 13v8M15 13v8"></path>
          </svg>
          <span
            class="font-heading font-semibold tracking-tight text-xl md:text-2xl"
            >nirast</span
          >
        </div>
      </div>

      <!-- Logo 7: amara -->
      <div
        class="bg-brand-dark h-32 md:h-40 flex items-center justify-center p-6 hover:bg-white/[0.02] transition-colors duration-300"
      >
        <div
          class="flex items-center text-white/50 hover:text-white/80 transition-colors"
        >
          <svg
            class="size-8 md:size-9 mr-3"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.5"
          >
            <circle cx="12" cy="12" r="4"></circle>
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 2a10 10 0 1010 10v-2a4 4 0 00-8 0v2"></path>
          </svg>
          <span
            class="font-heading font-semibold tracking-tight text-xl md:text-2xl"
            >amara</span
          >
        </div>
      </div>

      <!-- Logo 8: stari -->
      <div
        class="bg-brand-dark h-32 md:h-40 flex items-center justify-center p-6 hover:bg-white/[0.02] transition-colors duration-300"
      >
        <div
          class="flex items-center text-white/50 hover:text-white/80 transition-colors"
        >
          <svg
            class="size-8 md:size-9 mr-3"
            fill="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              d="M12 2c0 5.5-4.5 10-10 10 5.5 0 10 4.5 10 10 0-5.5 4.5-10 10-10-5.5 0-10-4.5-10-10z"
            ></path>
          </svg>
          <span
            class="font-heading font-semibold tracking-tight text-xl md:text-2xl"
            >stari</span
          >
        </div>
      </div>
    </div>
  </div>
</section>
